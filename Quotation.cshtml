@page
@model MIS_Study.Pages.Masters.QuotationModel
@{
    ViewData["Title"] = "Quotation";
}
<div class="page">
    <div class="page-wrapper">
        <div class="page-body">
            <div class="container container-x1 py-4">

                <form class="card card-md" id="quotation-Form" method="post" enctype="multipart/form-data">
 <input type="hidden" id="HdnEnquiry" asp-for="@Model.Quotation.Enquiry_No" />
                    <input type="hidden" id="HdnQuotationNo" asp-for="@Model.Quotation.Quotation_No" />
                    <input type="hidden" id="HdnQuotationDetailsID" asp-for="@Model.QuotationDetails.QuotationDetails_ID" />
                    <input type="hidden" id="HdnQuotationTaxableAmount" asp-for="@Model.Quotation.Quotation_TaxableAmount" />
                    <input type="hidden" id="HdnVendorState" />
                    <input type="hidden" id="HdnQuotationEdit" asp-for="@Model.QuotationEdit" />
                    <input type="hidden" id="HdnEditRange" />

               
                    
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Add/ Edit Quotation Details</h3>
                        </div>
                        <div class="card-body">
                            <p class="note mb-4">Fields marked with <span class="text-danger">*</span>are mandatory</p>

                            <div class="row">
<div class="col-lg-3 col-md-5 col-12">
                                    <div class="mb-2">
                                        <label class="form-label" id="lblEnquiry">Enquiry No<span class="text-danger">*</span></label>
                                        <span class="input-group-text" style="width:100%; text-align:left">
                                            <select class="select2 select2-hidden-accessible" id="drpEnquiry"style="width: 100%;" data-select2-id="drpEnquiry" aria-hidden="true" title="Please select a vendor" asp-items="@Model.EnquiryList" asp-for="@Model.Quotation.Enquiry_No">
                                                <option disabled selected>---Select Enquiry No---</option>
                                            </select>
                                        </span>
                                        <div class="mb-3" style="width:100%">
                                            <span asp-validation-for="@Model.Quotation.Enquiry_No" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                
